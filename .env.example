# ── API ──
API_MODE=local
NEXT_PUBLIC_API_MODE=local

# ── Supabase ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL (Supabase → Settings → Database → Connection string)
# Transaction pooler (app en producción):
DATABASE_URL=postgresql://postgres.your-project:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Conexión directa (migraciones prisma db push):
DIRECT_URL=postgresql://postgres.your-project:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

