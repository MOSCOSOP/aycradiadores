generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                   Int             @id @default(autoincrement())
  name                 String
  tradeName            String
  ruc                  String          @unique
  logo                 String?
  soapSendId           String          @default("01")
  soapTypeId           String          @default("02")
  soapUsername         String?
  soapPassword         String?
  soapUrl              String?
  soapSunatUsername    String?
  soapSunatPassword    String?
  certificate          String?
  certificatePem       String?         @db.Text
  certificatePassword  String?
  certificateDue       DateTime?
  apiSunatId           String?
  apiSunatSecret       String?
  sireClientId         String?
  sireClientSecret     String?
  sireUsername         String?
  sirePassword         String?
  pse                  Boolean         @default(false)
  pseUrl               String?
  pseToken             String?
  clientIdPse          String?
  sendDocumentToPse    Boolean         @default(false)
  typeSendPse          Int             @default(2)
  isRus                Boolean         @default(false)
  operationAmazonia    Boolean         @default(false)
  detractionAccount    String?
  footerTextTemplate   String?
  configSystemEnv      Int             @default(0)
  pendingRucCert       Boolean         @default(false)
  pendingRucSoap       Boolean         @default(false)
  pendingRucName       Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  establishments       Establishment[]
}

model Establishment {
  id          Int            @id @default(autoincrement())
  code        String         @default("0000")
  description String
  address     String?
  email       String?
  telephone   String?
  active      Boolean        @default(true)
  companyId   Int
  company     Company        @relation(fields: [companyId], references: [id])
  users       User[]
  series      Series[]
  documents   Document[]
  cashBoxes   CashRegister[]
}

model User {
  id              Int           @id @default(autoincrement())
  name            String
  email           String        @unique
  password        String
  type            String        @default("admin")
  permissions     String?
  active          Boolean       @default(true)
  establishmentId Int
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  documents       Document[]    @relation("SellerDocuments")
  createdAt       DateTime      @default(now())
}

model Series {
  id              Int           @id @default(autoincrement())
  number          String
  documentTypeId  String
  establishmentId Int
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  currentNumber   Int           @default(0)

  @@unique([number, establishmentId])
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  items       Item[]
}

model Customer {
  id                       Int          @id @default(autoincrement())
  identityDocumentTypeId   String       @default("6")
  name                     String
  number                   String
  verificationCode         String?
  sex                      String?
  birthDate                String?
  email                    String?
  telephone                String?
  address                  String?
  tradeName                String?
  country                  String?
  ubigeo                   String?
  creditDays               Int          @default(0)
  internalCode             String?
  barcode                  String?
  nationality              String?
  zone                     String?
  observations             String?
  googleMaps               String?
  contactName              String?
  contactPhone             String?
  contactDocument          String?
  applyRetention           Boolean      @default(false)
  secondaryAddress         String?
  secondaryPhone           String?
  deliveryReference        String?
  guarantorName            String?
  guarantorDocument        String?
  guarantorPhone           String?
  guarantorAddress         String?
  hasVehicle               Boolean      @default(false)
  vehicles                 String?
  active                   Boolean      @default(true)
  documents                Document[]
  dispatches               Dispatch[]
  saleNotes                SaleNote[]
  quotations               Quotation[]
  orderNotes               OrderNote[]
  createdAt                DateTime     @default(now())
}

model Supplier {
  id                     Int        @id @default(autoincrement())
  name                   String
  number                 String
  identityDocumentTypeId String     @default("6")
  tradeName              String?
  email                  String?
  telephone              String?
  address                String?
  country                String?
  ubigeo                 String?
  observations           String?
  internalCode           String?
  barcode                String?
  active                 Boolean    @default(true)
  purchases              Purchase[]
  expenses               Expense[]
  fixedAssets            FixedAsset[]
  createdAt              DateTime   @default(now())
}

model Item {
  id                    Int                 @id @default(autoincrement())
  sourceRemoteId        Int?                @unique
  internalId            String?
  description           String
  secondaryName         String?
  descriptionDetail     String?
  model                 String?
  unitTypeId            String              @default("NIU")
  kind                  String              @default("product")
  saleUnitPrice         Float               @default(0)
  purchasePrice         Float               @default(0)
  stock                 Float               @default(0)
  stockMin              Float               @default(0)
  location              String?
  active                Boolean             @default(true)
  imageUrl              String?
  barcode               String?
  brand                 String?
  brandId               Int?
  brandRef              Brand?              @relation(fields: [brandId], references: [id])
  lineId                Int?
  lineRef               Line?               @relation(fields: [lineId], references: [id])
  hasIgv                Boolean             @default(true)
  saleAffectationTypeId String              @default("10")
  categoryId            Int?
  category           Category?           @relation(fields: [categoryId], references: [id])
  documentItems      DocumentItem[]
  inventoryMovements InventoryMovement[]
  itemSetLines       ItemSetLine[]
  references         ItemReference[]
  lots               ItemLot[]
  returns            Return[]
  createdAt          DateTime            @default(now())
}

// Códigos equivalentes/alternos de un repuesto entre marcas o proveedores (ej. un mismo
// filtro con código OEM distinto al del fabricante) — reemplaza /inventory-references.
model ItemReference {
  id     Int     @id @default(autoincrement())
  itemId Int
  item   Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  code   String
  note   String?
}

// Tipos de descuento aplicables al vender (ej. "Cliente frecuente" 5%) — reemplaza
// /discount-types. Guarda el % real, no solo un nombre.
model DiscountType {
  id      Int    @id @default(autoincrement())
  name    String @unique
  percent Float  @default(0)
}

// Historial de ajustes masivos de precio (ej. +10% a toda una categoría) — reemplaza
// /price-adjustments. Queda como bitácora de lo que se aplicó y a cuántos productos.
model PriceAdjustment {
  id            Int      @id @default(autoincrement())
  description   String
  percent       Float
  filterType    String // "all" | "category" | "brand" | "line"
  filterId      Int?
  filterLabel   String?
  itemsAffected Int      @default(0)
  createdAt     DateTime @default(now())
}

// Lotes de compra de un producto (para trazabilidad/garantía) — reemplaza /item-lots.
model ItemLot {
  id           Int       @id @default(autoincrement())
  itemId       Int
  item         Item      @relation(fields: [itemId], references: [id])
  code         String
  quantity     Float     @default(0)
  purchaseDate DateTime?
  note         String?
  createdAt    DateTime  @default(now())
}

// Devoluciones de productos por parte del cliente — repone stock real y queda registrada.
// Reemplaza /devolutions.
model Return {
  id         Int       @id @default(autoincrement())
  documentId Int?
  document   Document? @relation(fields: [documentId], references: [id])
  itemId     Int
  item       Item      @relation(fields: [itemId], references: [id])
  quantity   Float
  reason     String?
  createdAt  DateTime  @default(now())
}

// Catálogo real de marcas de repuestos (ej. Bosch, Denso, Valeo) — reemplaza el catálogo
// genérico desconectado que existía en /brands.
model Brand {
  id    Int    @id @default(autoincrement())
  name  String @unique
  items Item[]
}

// Línea de negocio/producto (ej. Enfriamiento, Aire Acondicionado, Frenos) — clasificación
// complementaria a Category, reemplaza el catálogo genérico de /lines.
model Line {
  id    Int    @id @default(autoincrement())
  name  String @unique
  items Item[]
}

// Zonas geográficas/de reparto para clientes — reemplaza el catálogo genérico de /zones.
// Customer.zone sigue siendo texto libre, pero el formulario elige de esta lista real.
model Zone {
  id   Int    @id @default(autoincrement())
  name String @unique
}

// Packs y promociones — un combo de ítems a un precio fijo, vendible como una sola línea
// en un comprobante. Reemplaza el catálogo genérico de /item-sets.
model ItemSet {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  price       Float         @default(0)
  active      Boolean       @default(true)
  lines       ItemSetLine[]
  createdAt   DateTime      @default(now())
}

model ItemSetLine {
  id        Int     @id @default(autoincrement())
  itemSetId Int
  itemSet   ItemSet @relation(fields: [itemSetId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item    @relation(fields: [itemId], references: [id])
  quantity  Float   @default(1)
}

model Document {
  id              Int            @id @default(autoincrement())
  documentTypeId  String
  series          String
  number          Int
  fullNumber      String         @unique
  customerId      Int
  customer        Customer       @relation(fields: [customerId], references: [id])
  sellerId        Int
  seller          User           @relation("SellerDocuments", fields: [sellerId], references: [id])
  establishmentId Int
  establishment   Establishment  @relation(fields: [establishmentId], references: [id])
  dateOfIssue     DateTime
  dateOfDue       DateTime
  currencyTypeId  String         @default("PEN")
  exchangeRate    Float          @default(1)
  operationTypeId String         @default("0101")
  totalTaxed      Float          @default(0)
  totalIgv        Float          @default(0)
  totalExonerated Float          @default(0)
  total           Float          @default(0)
  plate           String?
  stateTypeId     String         @default("01")
  hasXml          Boolean        @default(false)
  hasPdf          Boolean        @default(true)
  hasCdr          Boolean        @default(false)
  xmlContent      String?        @db.Text
  cdrContent      String?        @db.Text
  voidReason      String?
  voidTicket      String?
  voidXmlContent  String?        @db.Text
  voidCdrContent  String?        @db.Text
  shareToken      String?        @unique
  items           DocumentItem[]
  returns         Return[]
  chatMessages    ChatMessage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model DocumentItem {
  id                    Int      @id @default(autoincrement())
  documentId            Int
  document              Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  itemId                Int?
  item                  Item?    @relation(fields: [itemId], references: [id])
  description           String
  unitTypeId            String   @default("NIU")
  quantity              Float
  unitValue             Float
  unitPrice             Float
  totalValue            Float
  totalPrice            Float
  saleAffectationTypeId String   @default("10")
}

model SaleNote {
  id             Int            @id @default(autoincrement())
  number         String         @unique
  customerId     Int
  customer       Customer       @relation(fields: [customerId], references: [id])
  date           DateTime       @default(now())
  total          Float          @default(0)
  state          String         @default("Registrado")
  plate          String?
  currencyTypeId String         @default("PEN")
  paymentStatus  String?
  purchaseOrder  String?
  modifiedPrice  String         @default("NO")
  shareToken     String?        @unique
  items          SaleNoteItem[]
  createdAt      DateTime       @default(now())
}

model SaleNoteItem {
  id          Int      @id @default(autoincrement())
  saleNoteId  Int
  saleNote    SaleNote @relation(fields: [saleNoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  total       Float
}

model Quotation {
  id         Int              @id @default(autoincrement())
  number     String           @unique
  customerId Int
  customer   Customer         @relation(fields: [customerId], references: [id])
  date       DateTime         @default(now())
  total      Float            @default(0)
  state      String           @default("Pendiente")
  shareToken String?          @unique
  items      QuotationItem[]
  createdAt  DateTime         @default(now())
}

model QuotationItem {
  id           Int       @id @default(autoincrement())
  quotationId  Int
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description  String
  quantity     Float
  unitPrice    Float
  total        Float
}

model Purchase {
  id         Int            @id @default(autoincrement())
  number     String         @unique
  supplierId Int
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  date       DateTime       @default(now())
  total      Float          @default(0)
  state      String         @default("Registrado")
  items      PurchaseItem[]
  createdAt  DateTime       @default(now())
}

model PurchaseItem {
  id          Int      @id @default(autoincrement())
  purchaseId  Int
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  total       Float
}

model CashRegister {
  id              Int           @id @default(autoincrement())
  description     String
  reference       String?
  sellerName      String?
  establishmentId Int
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  isOpen          Boolean       @default(false)
  openingBalance  Float         @default(0)
  currentBalance  Float         @default(0)
  closingBalance  Float         @default(0)
  realBalance     Float         @default(0)
  openedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime      @default(now())
}

model InventoryMovement {
  id          Int      @id @default(autoincrement())
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  type        String
  quantity    Float
  description String?
  reference   String?
  createdAt   DateTime @default(now())
}

model AppSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Dispatch {
  id              Int            @id @default(autoincrement())
  number          String         @unique
  guideType       String         @default("09")
  customerId      Int
  customer        Customer       @relation(fields: [customerId], references: [id])
  establishmentId Int?
  series          String?
  dateOfIssue     DateTime       @default(now())
  dateOfTransfer  DateTime?
  transferReason  String         @default("Venta")
  modeTransport   String         @default("01")
  unitMeasure     String         @default("KGM")
  packageCount    Int            @default(0)
  purchaseOrder   String?
  observations    String?
  originAddress   String?
  destAddress     String?
  plate           String?
  driverName      String?
  driverDocument  String?
  vehiclePlate    String?
  totalWeight     Float          @default(0)
  state           String         @default("Registrado")
  extraData       Json?
  items           DispatchItem[]
  createdAt       DateTime       @default(now())
}

model DispatchItem {
  id          Int      @id @default(autoincrement())
  dispatchId  Int
  dispatch    Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitTypeId  String   @default("NIU")
}

model OrderNote {
  id         Int             @id @default(autoincrement())
  number     String          @unique
  customerId Int
  customer   Customer        @relation(fields: [customerId], references: [id])
  date       DateTime        @default(now())
  total      Float           @default(0)
  state      String          @default("Pendiente")
  items      OrderNoteItem[]
  createdAt  DateTime        @default(now())
}

model OrderNoteItem {
  id           Int       @id @default(autoincrement())
  orderNoteId  Int
  orderNote    OrderNote @relation(fields: [orderNoteId], references: [id], onDelete: Cascade)
  description  String
  quantity     Float
  unitPrice    Float
  total        Float
}

model Account {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String
  type String
}

model JournalEntry {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  description String
  reference   String?
  accountCode String
  accountName String
  debit       Float    @default(0)
  credit      Float    @default(0)
}

// ── Contabilidad/RRHH avanzada ──

// Gastos diversos (alquiler, servicios, etc.) — reemplaza el catálogo genérico de /expenses.
// Ya se sumaban al dashboard desde datos importados; ahora también se pueden registrar en vivo.
model Expense {
  id          Int       @id @default(autoincrement())
  description String
  category    String?
  amount      Float
  date        DateTime  @default(now())
  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  note        String?
  createdAt   DateTime  @default(now())
}

// Activos fijos de la empresa (herramientas, equipos, vehículo de reparto) — unifica lo que
// antes eran dos catálogos genéricos separados (/fixed-asset/items y /fixed-asset/purchases).
model FixedAsset {
  id            Int       @id @default(autoincrement())
  name          String
  category      String?
  purchaseDate  DateTime?
  purchasePrice Float     @default(0)
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  status        String    @default("Activo") // Activo | En reparación | De baja
  note          String?
  createdAt     DateTime  @default(now())
}

// Planilla simplificada: trabajadores + planillas mensuales con neto a pagar. No reemplaza un
// sistema de planilla legal completo (AFP/ONP/essalud/PLAME) — es un registro real de sueldos
// para control interno, ya que ese nivel de cumplimiento legal excede el alcance de este sistema.
model Employee {
  id            Int           @id @default(autoincrement())
  name          String
  documentId    String?
  position      String?
  monthlySalary Float         @default(0)
  startDate     DateTime?
  active        Boolean       @default(true)
  payrollLines  PayrollLine[]
  createdAt     DateTime      @default(now())
}

model PayrollRun {
  id        Int           @id @default(autoincrement())
  period    String // "2026-09"
  lines     PayrollLine[]
  createdAt DateTime      @default(now())
}

model PayrollLine {
  id           Int        @id @default(autoincrement())
  payrollRunId Int
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   Int
  employee     Employee   @relation(fields: [employeeId], references: [id])
  baseSalary   Float
  bonuses      Float      @default(0)
  deductions   Float      @default(0)
  netPay       Float
}

// Retenciones y percepciones — solo aplican si SUNAT te designó como agente de retención o
// percepción (no todos los negocios lo son). Queda como registro real por si se necesita.
model TaxWithholding {
  id            Int      @id @default(autoincrement())
  type          String // "retention" | "perception"
  partyName     String
  partyDocument String?
  documentRef   String?
  baseAmount    Float
  percent       Float
  amount        Float
  date          DateTime @default(now())
  note          String?
}

// Chat en vivo con clientes: el cliente se identifica solo con nombre + DNI
// (sin contraseña, como WhatsApp), pensado para consultas rápidas de stock/precio
// y para poder generar y compartir un comprobante sin salir de la conversación.
model ChatCustomer {
  id         Int           @id @default(autoincrement())
  name       String
  dni        String        @unique
  pinHash    String? // null = cuenta creada antes del PIN; se le pide crear uno en su próximo ingreso
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  messages   ChatMessage[]
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  chatCustomerId Int
  chatCustomer   ChatCustomer @relation(fields: [chatCustomerId], references: [id], onDelete: Cascade)
  sender         String // "customer" | "admin"
  body           String       @db.Text
  imageUrl       String?      @db.Text // foto enviada por el cliente, como data URL (sin bucket externo)
  documentId     Int?
  document       Document?    @relation(fields: [documentId], references: [id])
  readByAdmin    Boolean      @default(false)
  readByCustomer Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// Catálogos reales para guías de remisión (antes eran módulos genéricos con etiquetas en
// inglés y sin lógica real). Un conductor/vehículo/punto de partida real permite que la guía
// de remisión tenga sentido para SUNAT y para la empresa.
model Driver {
  id             Int      @id @default(autoincrement())
  name           String
  documentNumber String?
  license        String?
  telephone      String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Vehicle {
  id        Int      @id @default(autoincrement())
  plate     String   @unique
  brand     String?
  model     String?
  capacity  Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model OriginAddress {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  ubigeo    String?
  reference String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Libro de Reclamaciones — obligatorio por ley para cualquier negocio con local físico en Perú
// (D.S. 011-2011-PCM). Antes era un catálogo genérico sin ninguna lógica real.
model ComplaintBookEntry {
  id               Int      @id @default(autoincrement())
  number           String   @unique
  date             DateTime @default(now())
  type             String // "Reclamo" | "Queja"
  customerName     String
  customerDocument String?
  customerPhone    String?
  customerEmail    String?
  customerAddress  String?
  itemType         String // "Producto" | "Servicio"
  claimedAmount    Float?
  description      String   @db.Text
  request          String?  @db.Text // pedido del consumidor
  resolution       String?  @db.Text // acciones adoptadas por la empresa
  state            String   @default("Pendiente") // "Pendiente" | "Resuelto"
  createdAt        DateTime @default(now())
}
