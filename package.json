{
  "name": "inicia-factura-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "clone:ui": "python scripts/clone_ui.py",
    "clone:all": "python scripts/clone_all.py",
    "clone:data": "python scripts/import_data.py",
    "clone:sale-notes": "python scripts/import_data.py --only sale_notes",
    "clone:full": "python scripts/clone_all.py && python scripts/import_data.py",
    "preview:extracted": "python scripts/serve_extracted.py",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^3.0.3",
    "bootstrap-icons": "^1.13.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "prisma": "5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
